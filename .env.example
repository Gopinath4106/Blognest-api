# Copy this file to ".env" and fill in real values.
# The application will run perfectly fine WITHOUT an OPENAI_API_KEY
# by automatically using its built-in offline Demo AI mode.

# Flask session secret key (use any long random string in production)
SECRET_KEY=change-this-to-a-random-secret-key

# --- AI Configuration (optional) ---
# Leave OPENAI_API_KEY empty/unset to run in Demo AI Mode (no external calls).
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Default admin bootstrap account (used by create_admin.py) ---
ADMIN_EMAIL=admin@blognest.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Site Administrator
